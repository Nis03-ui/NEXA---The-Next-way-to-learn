# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=NEXA LMS API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://nexa:nexapassword@localhost:5432/nexadb

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Option 1: Use the full URL
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Option 2: Use individual values
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── File Uploads ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_GENERAL_PER_MINUTE=100
